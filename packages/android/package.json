{
	"name": "@alivelabs/expo-simless-android",
	"version": "0.1.0-alpha.0",
	"description": "The expo-simless renderer for Android: draws with Android's own views on an emulator booted from a snapshot.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alive-home/expo-simless.git",
		"directory": "packages/android"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"host",
		"README.md"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit -p .",
		"prepack": "pnpm run build"
	},
	"peerDependencies": {
		"@alivelabs/expo-simless": "workspace:^"
	},
	"devDependencies": {
		"@alivelabs/expo-simless": "workspace:*"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	}
}
