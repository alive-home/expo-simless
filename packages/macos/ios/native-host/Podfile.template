# Generated by simless. Links the project's own native modules, found by its own autolinking, into a Mac
# Catalyst host. The placeholders are filled in by src/nativeHost.ts.
require 'json'

PROJECT_ROOT = __PROJECT_ROOT__
EXCLUDE = __EXCLUDE__
CONFIG_SCRIPT = __CONFIG_SCRIPT__
CATALYST_SHIMS = __CATALYST_SHIMS__

def package_dir(name)
  File.dirname(`node --print "require.resolve('#{name}/package.json', { paths: ['#{PROJECT_ROOT}'] })"`.strip)
end

require File.join(package_dir('expo'), 'scripts/autolinking')
require File.join(package_dir('react-native'), 'scripts/react_native_pods')

platform :ios, '17.0'
install! 'cocoapods', :deterministic_uuids => false
prepare_react_native_project!

target 'SimlessHost' do
  use_expo_modules!(projectRoot: PROJECT_ROOT, exclude: EXCLUDE)

  config = use_native_modules!(['node', CONFIG_SCRIPT, PROJECT_ROOT, EXCLUDE.to_json, __dir__])

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => PROJECT_ROOT,
  )

  post_install do |installer|
    react_native_post_install(installer, config[:reactNativePath], :mac_catalyst_enabled => true)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_configuration|
        build_configuration.build_settings['SUPPORTS_MACCATALYST'] = 'YES'
        # Pods that declare an older iOS floor still build for the host's.
        build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
        # Searched before everything else; see catalyst-shims/AppKit/AppKit.h.
        paths = build_configuration.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
        paths = paths.join(' ') if paths.is_a?(Array)
        build_configuration.build_settings['HEADER_SEARCH_PATHS'] = "\"#{CATALYST_SHIMS}\" #{paths}"
      end
    end
  end
end
