{
	"name": "@alivelabs/expo-simless-macos",
	"version": "0.1.0-alpha.3",
	"description": "The expo-simless renderer for iOS: draws with the iOS UIKit a Mac runs through Mac Catalyst.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alive-home/expo-simless.git",
		"directory": "packages/macos"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"ios",
		"README.md"
	],
	"os": [
		"darwin"
	],
	"engines": {
		"node": ">=23.6"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit -p .",
		"prepack": "pnpm run build"
	},
	"peerDependencies": {
		"@alivelabs/expo-simless": "workspace:^"
	},
	"devDependencies": {
		"@alivelabs/expo-simless": "workspace:*"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	}
}
