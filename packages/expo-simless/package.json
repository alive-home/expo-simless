{
	"name": "@alivelabs/expo-simless",
	"version": "0.1.0-alpha.0",
	"description": "Render the screens and components of an Expo app to PNGs, with no simulator.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alive-home/expo-simless.git",
		"directory": "packages/expo-simless"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./runtime/index.d.ts",
			"default": "./runtime/index.js"
		},
		"./renderer": "./src/renderer.ts"
	},
	"bin": {
		"simless": "./bin/simless.js"
	},
	"files": [
		"dist",
		"runtime",
		"report",
		"README.md"
	],
	"engines": {
		"node": ">=23.6"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit -p .",
		"prepack": "pnpm run build"
	},
	"peerDependencies": {
		"react-native": ">=0.88"
	},
	"peerDependenciesMeta": {
		"react-native": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"bin": {
			"simless": "./dist/bin.js"
		},
		"exports": {
			".": {
				"types": "./runtime/index.d.ts",
				"default": "./runtime/index.js"
			},
			"./renderer": {
				"types": "./dist/renderer.d.ts",
				"default": "./dist/renderer.js"
			}
		}
	}
}
